rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email in [
          'micheljetmaulas@gmail.com',
          'donnabatchar@gmail.com'
        ];
    }

    match /coupleMemories/{memoryId} {
      allow read: if isAllowedUser();
      allow create: if isAllowedUser() && request.resource.data.uploadedBy == request.auth.uid;
      allow update: if isAllowedUser() && resource.data.uploadedBy == request.auth.uid && request.resource.data.uploadedBy == request.auth.uid;
      allow delete: if isAllowedUser() && resource.data.uploadedBy == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
