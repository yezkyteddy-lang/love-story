rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email in [
          'micheljetmaulas@gmail.com',
          'donnabatchar@gmail.com'
        ];
    }

    match /couple-memories/{uid}/{fileName=**} {
      allow read: if isAllowedUser();
      allow write: if isAllowedUser() && request.auth.uid == uid
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAllowedUser() && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
